// SeuConvite IA — schema Prisma (PostgreSQL / Supabase).
//
// A producao roda no Supabase (Postgres) e usa FOREIGN KEYS REAIS: o banco aplica
// integridade referencial e `onDelete: Cascade` de verdade. O modelo antigo de
// PlanetScale/MySQL com `relationMode = "prisma"` (cascade emulado na aplicacao)
// foi aposentado em 2026-08-16 para o local e a producao falarem a mesma lingua.
// Consequencias seguidas aqui:
//   - Toda coluna escalar de relacao (FK) continua com `@@index` explicito: o
//     Postgres NAO cria indice automatico do lado que referencia.
//   - Cascades sao do BANCO; a limpeza manual na aplicacao virou redundancia segura.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (runtime)
  directUrl = env("DIRECT_URL")   // conexao direta (migrations)
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Plan {
  BASICO
  CLASSICO
  PREMIUM
}

enum EventType {
  CASAMENTO
  QUINZE_ANOS
  SESSENTA_ANOS
  BODAS
  ANIVERSARIO
}

enum EventStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum GiftMode {
  PIX
  ITEM
}

enum GiftPricing {
  FIXO
  COTAS
  LIVRE
}

enum PayStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ----------------------------------------------------------------------------
// Models
// ----------------------------------------------------------------------------

/// Tenant da plataforma: o profissional/estudio que cria os sites de evento.
model Professional {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  /// Plano CONTRATADO. Sozinho ele mente: quem diz o direito de hoje e
  /// `planoEfetivo()` (contratado + vencimento). Ver lib/plans.ts.
  plan         Plan     @default(BASICO)
  /// Assinatura no Mercado Pago (`preapproval`). UNICO: duas contas nao podem
  /// apontar para a mesma assinatura — e por ele que o webhook acha o dono.
  mpPreapprovalId  String?   @unique
  /// Espelha o MP: `pending` | `authorized` | `paused` | `cancelled`.
  assinaturaStatus String?
  /// Ate quando o plano pago vale. E o que sustenta a carencia: cancelar nao
  /// corta na hora, o vencimento e que corta.
  assinaturaAte    DateTime?
  /// WhatsApp com DDD, so digitos. Pedido no cadastro: e por onde o suporte
  /// alcanca quem esta com a festa em cima da hora.
  telefone     String?
  /// CPF ou CNPJ do titular, so digitos. Pedido no CHECKOUT (dado de cobranca,
  /// nao de cadastro) — e o mesmo documento que o MP pede na tela do cartao.
  documento    String?
  /// `proprio` (faz a festa dele) | `profissional` (faz para clientes).
  /// Muda a linguagem do painel e diz para quem estamos vendendo.
  perfilUso    String?
  avatarUrl    String?
  brandName    String?
  brandLogoUrl String?
  brandColors  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events    Event[]
  cobrancas CobrancaAssinatura[]
  passwordResets PasswordReset[]
  creditos      CreditoConvite[]
}

/// Pedido de REDEFINICAO DE SENHA.
///
/// Guarda o HASH do token, nunca o token: se este banco vazar, o que esta
/// gravado aqui nao serve para entrar em conta nenhuma. `tokenHash` e unico
/// porque o link e a credencial — dois pedidos nunca podem colidir.
///
/// `usedAt` faz o link ser de USO UNICO (link de e-mail vive em caixa de
/// entrada, em historico de navegador e em preview de mensageiro), e
/// `expiresAt` limita a janela.
model PasswordReset {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([professionalId])
}


/// Cobranca mensal da ASSINATURA do SaaS (o profissional pagando a plataforma).
///
/// Nao reusa `Transaction`: aquela e amarrada a um `Event` por FK, e assinatura
/// e da CONTA, nao do evento.
model CobrancaAssinatura {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         String
  /// Id do pagamento no MP. UNICO: o webhook pode entregar a mesma notificacao
  /// duas vezes, e o banco tem de recusar a segunda.
  providerId     String       @unique
  paidAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([professionalId])
}

/// Evento (site de convite) pertencente a um Professional.
model Event {
  id             String      @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  type           EventType
  subdomain      String      @unique
  title          String
  templateId     String?
  template       Template?   @relation(fields: [templateId], references: [id])
  eventDate      DateTime
  expiresAt      DateTime
  status         EventStatus @default(DRAFT)
  // Plano HERDADO da conta (assinatura): o evento usa o plano do profissional;
  // o gating de recursos (rsvp/recados/galeria/white-label/dominio) deriva daqui.
  plan           Plan        @default(BASICO)
  customization  Json?
  // Documento canônico do editor (Fase 1). Campos legados acima permanecem
  // durante o rollout para convites existentes e rollback seguro.
  draftData       Json?
  draftVersion    Int         @default(0)
  publishedData   Json?
  publishedVersion Int        @default(0)
  schemaVersion   Int         @default(1)
  publishedAt     DateTime?
  /// Ate quando a edicao do SITE esta liberada (cortesia, cota do plano ou
  /// passe pago). Nulo = fechado. E a unica pergunta do sistema: `> agora`?
  edicaoAte      DateTime?
  /// Quantas liberacoes INCLUIDAS no plano ja foram USADAS neste convite (nao e
  /// saldo: o teto vem do plano, em `passesIncluidos()`).
  passesGratisUsados Int     @default(0)
  /// Tirado do ar pelo dono. Nao volta para DRAFT — sair do ar nao pode ser um
  /// destravamento gratuito da edicao.
  foraDoAr       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Dados de recebimento do dono (resgate); NUNCA expostos no site publico.
  payoutPixKey  String?
  payoutPixName String?

  guests        Guest[]
  gifts         GiftItem[]
  photos        Photo[]
  recados       Recado[]
  transactions  Transaction[]
  contributions GiftContribution[]
  payouts       Payout[]
  credito       CreditoConvite?

  @@index([professionalId])
  @@index([templateId])
  @@index([expiresAt])
  @@index([status])
}

/// Convidado de um evento (RSVP).
model Guest {
  id         String      @id @default(cuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  status     GuestStatus @default(PENDING)
  companions Int         @default(0)
  /// Recado que o convidado escreveu. ATE 18/08/2026 este campo guardava tudo
  /// amassado numa frase ("Confirmados: … · Tel: … · Restricao: …") porque nao
  /// havia onde por o resto; as linhas antigas seguem assim e a ficha do painel
  /// sabe ler as duas formas (ver `lib/rsvpFicha.ts`).
  message    String?     @db.Text
  /// Contato e restricao, quando o convite pediu (`rsvpConfig`).
  phone      String?
  email      String?
  dietary    String?     @db.Text
  /// Quem vai e quem nao vai, nome a nome:
  /// `[{ nome, tipo: "adulto" | "crianca", vai: boolean }]`.
  party      Json?
  createdAt  DateTime    @default(now())

  @@index([eventId])
}

/// Item da lista de presentes (Pix ou item).
model GiftItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  imageUrl    String?
  priceCents  Int
  mode        GiftMode    @default(PIX)
  // Como o item pode ser presenteado: FIXO = preco unico; COTAS = priceCents e o
  // total, dividido em quotaCount cotas; LIVRE = priceCents e o valor MINIMO.
  pricingMode GiftPricing @default(FIXO)
  quotaCount  Int?
  // Presente tipo LINK de loja (mode=ITEM): URL externa (Amazon etc.). O convidado
  // compra direto na loja; nao passa pela plataforma (sem taxa/cofre).
  storeUrl    String?     @db.Text
  pixPayload  String?     @db.Text
  purchased   Boolean     @default(false)
  buyerName   String?
  createdAt   DateTime    @default(now())

  contributions GiftContribution[]

  @@index([eventId])
}

/// Foto do album do evento.
model Photo {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([eventId])
}

/// Recado do mural publico de um evento (mensagem de carinho de um convidado).
/// Auto-aprovado por enquanto (`approved` default true); moderacao vira depois.
model Recado {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  message   String   @db.Text
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([eventId])
}

/// Template de site por nicho.
model Template {
  id        String    @id @default(cuid())
  name      String
  nicho     EventType
  config    Json
  createdAt DateTime  @default(now())

  events Event[]

  @@index([nicho])
}

/// Transacao financeira ligada a um evento (presente via Pix, taxa do evento, etc.).
model Transaction {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amountCents Int
  kind        String // ex.: "GIFT_PIX", "EVENT_FEE"
  status      String   @default("PENDING")
  /// Id da cobranca no gateway. UNICO: e a rede de seguranca do ledger — se
  /// duas confirmacoes escaparem do compare-and-set, o banco recusa a segunda
  /// em vez de lancar o mesmo pagamento duas vezes. Nulo e permitido varias
  /// vezes no Postgres (lancamentos sem gateway).
  providerId  String?  @unique
  createdAt   DateTime @default(now())

  @@index([eventId])
}

/// Uma contribuicao de um convidado a um item da lista (presente via Pix).
/// O convidado paga a PLATAFORMA; a taxa e retida e o liquido credita o cofre.
model GiftContribution {
  id               String    @id @default(cuid())
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  giftItemId       String
  giftItem         GiftItem  @relation(fields: [giftItemId], references: [id], onDelete: Cascade)
  buyerName        String
  buyerContact     String?
  message          String?   @db.Text
  quotas           Int?
  grossCents       Int
  feeCents         Int
  netCents         Int
  status           PayStatus @default(PENDING)
  provider         String    @default("fake")
  /// UNICO: uma cobranca do gateway pertence a UMA contribuicao. Sem isto,
  /// um reenvio do webhook com outro `contributionId` poderia duplicar o
  /// recebimento do mesmo Pix.
  providerChargeId String?   @unique
  pixCode          String?   @db.Text
  pixQrUrl         String?   @db.Text
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([eventId])
  @@index([giftItemId])
  @@index([status])
}

/// Resgate (saque) do saldo de um convite para a chave Pix do dono.
model Payout {
  id                 String    @id @default(cuid())
  eventId            String
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amountCents        Int
  pixKey             String
  pixName            String?
  status             PayStatus @default(PENDING)
  provider           String    @default("fake")
  providerTransferId String?
  createdAt          DateTime  @default(now())
  paidAt             DateTime?

  @@index([eventId])
}

/// Credito avulso que compra UMA criacao de convite no plano Gratis.
///
/// Mesmo contrato do passe de edicao: a action cria a linha PENDING e quem
/// concede e o webhook. O SALDO nao mora em coluna nenhuma — e a contagem de
/// linhas PAID com `eventId` nulo, pelo mesmo motivo que `planoEfetivo` deriva
/// o plano na leitura: contador guardado sai de sincronia.
model CreditoConvite {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         String       @default("PENDING")
  /// Id da cobranca no gateway. UNICO: rede do ledger, como em `Transaction`.
  providerId     String?      @unique
  paidAt         DateTime?
  /// O convite que ESTE credito pagou. Nulo = credito na mao, nao gasto.
  /// UNICO: e o que torna gasto duplo impossivel NO BANCO.
  /// SetNull: apagar o convite devolve o credito — quem apagou nao ficou com ele.
  eventId        String?      @unique
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([professionalId])
}
