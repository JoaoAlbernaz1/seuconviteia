# Copie para `.env` e preencha. NUNCA commite o `.env` (ja esta no .gitignore).
#
# ATENCAO: as conexoes do banco moram no `.env`, nao no `.env.local`.
# O Prisma CLI le apenas o `.env` — `.env.local` e convencao do Next.js e o CLI
# o ignora, causando "Environment variable not found: DIRECT_URL" nas migrations.

# --- Banco ---
# Dev local: Postgres 17 em Docker, container `sc-postgres`, PORTA 5433.
#   docker run -d --name sc-postgres --restart unless-stopped \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=seuconviteia \
#     -p 5433:5432 postgres:17
# (5433 e nao 5432 porque pode haver um PostgreSQL nativo do Windows na 5432.)
#
# Producao: projeto Supabase `seuconviteia-prod`. As duas variaveis sao
# DIFERENTES e ambas obrigatorias:
#   DATABASE_URL -> pooler, porta 6543, com ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   -> conexao direta, porta 5432, so para migrations
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/seuconviteia"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/seuconviteia"

# --- Auth.js v5 ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Cron ---
# Protege /api/cron/expirar (agendado no vercel.json, diario as 06:00 UTC).
CRON_SECRET=""

# --- Multi-tenancy ---
# Dev: localhost:3000 (Chrome resolve *.localhost, entao cliente.localhost:3000 funciona).
# Prod: o dominio publico.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
